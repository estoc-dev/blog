---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { locales, type Translations } from "../../../i18n.ts";
import { allPosts, translationsOf, type Post } from "../../../posts.ts";

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({
    params: { lang: post.lang, slug: post.slug },
    props: { post, translations: translationsOf(post, posts) },
  }));
}

const { post, translations } = Astro.props as { post: Post; translations: Translations };
const { title, description, date } = post.entry.data;
const { Content } = await render(post.entry);
---

<Base lang={post.lang} title={title} description={description} translations={translations}>
  <article>
    <h1>{title}</h1>
    <time datetime={date.toISOString().slice(0, 10)}>{locales[post.lang].date(date)}</time>
    <Content />
  </article>
</Base>
