---
import { home, langs, locales, type Lang } from "../i18n.ts";
import "../styles/site.css";

const fallback: Lang = "en";
---

<!doctype html>
<html lang="mul">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Estoc</title>
    <script is:inline define:vars={{ langs, fallback }}>
      const preferred = navigator.languages
        .map((tag) => tag.split("-")[0].toLowerCase())
        .find((code) => langs.includes(code));
      location.replace(`/${preferred ?? fallback}/`);
    </script>
    {langs.map((lang) => <link rel="alternate" hreflang={locales[lang].tag} href={new URL(home(lang), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="wrap">
      <header>
        <span class="wordmark"><img src="/favicon.svg" alt="" />Estoc</span>
      </header>
      <main>
        <ul class="choice">
          {langs.map((lang) => <li><a href={home(lang)} hreflang={locales[lang].tag} lang={locales[lang].tag}>{locales[lang].name}</a></li>)}
        </ul>
      </main>
    </div>
  </body>
</html>
