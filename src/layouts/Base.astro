---
import { home, langs, locales, type Lang, type Translations } from "../i18n.ts";
import "../styles/site.css";

interface Props {
  lang: Lang;
  title?: string;
  description: string;
  translations: Translations;
}

const { lang, title, description, translations } = Astro.props;
const site = "Estoc";
const alternates = langs.flatMap((other) => {
  const path = translations[other];
  return path === undefined ? [] : [{ tag: locales[other].tag, url: new URL(path, Astro.site) }];
});
const switches = langs
  .filter((other) => other !== lang)
  .map((other) => ({ ...locales[other], path: translations[other] ?? home(other) }));
---

<!doctype html>
<html lang={locales[lang].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title === undefined ? site : `${title} · ${site}`}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? site} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {alternates.map(({ tag, url }) => <link rel="alternate" hreflang={tag} href={url} />)}
    <link rel="alternate" type="application/rss+xml" title={site} href={`${home(lang)}rss.xml`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="wordmark" href={home(lang)}><img src="/favicon.svg" alt="" />{site}</a>
        <nav class="langs">
          {switches.map(({ tag, name, path }) => <a href={path} hreflang={tag} lang={tag}>{name}</a>)}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <span>Everyone's Sovereign Toolkit</span>
        <a href={`${home(lang)}rss.xml`}>RSS</a>
        <a href="https://github.com/estoc-dev">GitHub</a>
      </footer>
    </div>
  </body>
</html>
